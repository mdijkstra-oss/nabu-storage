# Listen port for a local run. Under compose the container is always on 8080 and
# STORAGE_PORT moves the host side of it.
PORT=8080
# STORAGE_PORT=8080

LOG_LEVEL=info

# Required for a local run, and the server refuses to start without it. An
# absolute path to a directory that already exists and is writable: every project
# directory is created under it, and a path that is merely plausible is a server
# that serves an empty corpus and throws its writes away. Under compose this is
# ignored — compose.yaml points the container at its own volume.
PERSISTENCE_DIR=

CORS_ORIGINS=*
