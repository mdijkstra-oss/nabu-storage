{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "LLM: This schema uses array children (ProjectArrayView). Keep in sync with projections/project-entity/view.go ProjectArrayView struct. The Go entity uses map children for fast lookup, but this schema uses arrays for SQL/JSON compatibility.",
  "title": "Project",
  "type": "object",
  "required": ["id", "healthy", "version", "name", "phase", "charts", "codes", "files"],
  "properties": {
    "id": { "type": "string" },
    "healthy": { "type": "boolean" },
    "version": { "type": "integer" },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "phase": {
      "type": "string",
      "enum": ["explore", "code", "validate", "analyze"]
    },
    "charts": {
      "type": "array",
      "items": { "$ref": "../chart/schema.json" }
    },
    "codes": {
      "type": "array",
      "items": { "$ref": "../code/schema.json" }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "../file/schema.json" }
    }
  }
}
